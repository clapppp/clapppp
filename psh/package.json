{
  "name": "psh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run sync-assets && node server.js",
    "build": "npm run sync-assets && next build",
    "start": "cross-env NODE_ENV=production node server.js",
    "lint": "next lint",
    "pre-push": "npm run build && cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/",
    "sync-assets": "node scripts/sync-assets.mjs"
  },
  "dependencies": {
    "@types/ws": "^8.5.12",
    "geist": "^1.3.1",
    "gray-matter": "^4.0.3",
    "next": "^16.1.6",
    "next-mdx-remote": "^6.0.0",
    "react": "^18",
    "react-dom": "^18",
    "react-icons": "^5.3.0",
    "three": "^0.128.0",
    "websocket-playground": "git+https://github.com/clapppp/websocket.git#v1.0.0",
    "ws": "^8.18.0",
    "peercon-docs": "git+https://github.com/clapppp/peercon.git#v1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/three": "^0.168.0",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "^16.1.6",
    "file-loader": "^6.2.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
